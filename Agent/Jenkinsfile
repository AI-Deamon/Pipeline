import groovy.transform.Field

@Field def STAGES_RESULTS = []
@Field def PROJECT = [:]
@Field def SELECTED = []
@Field def IS_MANUAL = false
@Field def IMAGE_TAG = ''

// Dynamic dependency detection function - finds all package manager files in repo
def findDependencyFiles() {
    def dependencies = [
        npm: [],
        pip: [],
        yarn: [],
        poetry: []
    ]
    
    // Search for dependency files in entire repository (exclude node_modules)
    sh "find . -type f -name 'package.json' -not -path '*/node_modules/*' 2>/dev/null > npm_files.txt"
    sh "find . -type f -name 'requirements.txt' -not -path '*/node_modules/*' 2>/dev/null > pip_files.txt"
    sh "find . -type f -name 'yarn.lock' -not -path '*/node_modules/*' 2>/dev/null > yarn_files.txt"
    sh "find . -type f -name 'pyproject.toml' -not -path '*/node_modules/*' 2>/dev/null > poetry_files.txt"
    
    if (fileExists('npm_files.txt')) {
        def npmFiles = readFile('npm_files.txt').trim()
        dependencies.npm = npmFiles ? npmFiles.split('\n').findAll { it.trim() } : []
    }
    if (fileExists('pip_files.txt')) {
        def pipFiles = readFile('pip_files.txt').trim()
        dependencies.pip = pipFiles ? pipFiles.split('\n').findAll { it.trim() } : []
    }
    if (fileExists('yarn_files.txt')) {
        def yarnFiles = readFile('yarn_files.txt').trim()
        dependencies.yarn = yarnFiles ? yarnFiles.split('\n').findAll { it.trim() } : []
    }
    if (fileExists('poetry_files.txt')) {
        def poetryFiles = readFile('poetry_files.txt').trim()
        dependencies.poetry = poetryFiles ? poetryFiles.split('\n').findAll { it.trim() } : []
    }
    
    // Cleanup temporary files
    sh "rm -f npm_files.txt pip_files.txt yarn_files.txt poetry_files.txt"
    
    echo "Found dependencies: npm=${dependencies.npm.size()}, pip=${dependencies.pip.size()}, yarn=${dependencies.yarn.size()}, poetry=${dependencies.poetry.size()}"
    
    return dependencies
}

// Get unique scan paths from dependency files
def getDependencyScanPaths() {
    def dependencies = findDependencyFiles()
    def scanPaths = []
    
    // Add directory containing each npm package.json
    dependencies.npm.each { file ->
        def dir = file.substring(0, file.lastIndexOf('/'))
        if (dir && !scanPaths.contains(dir)) {
            scanPaths << dir
        }
    }
    
    // Add directory containing each pip requirements.txt
    dependencies.pip.each { file ->
        def dir = file.substring(0, file.lastIndexOf('/'))
        if (dir && !scanPaths.contains(dir)) {
            scanPaths << dir
        }
    }
    
    // Add directories from yarn
    dependencies.yarn.each { file ->
        def dir = file.substring(0, file.lastIndexOf('/'))
        if (dir && !scanPaths.contains(dir)) {
            scanPaths << dir
        }
    }
    
    // Add directories from poetry
    dependencies.poetry.each { file ->
        def dir = file.substring(0, file.lastIndexOf('/'))
        if (dir && !scanPaths.contains(dir)) {
            scanPaths << dir
        }
    }
    
    // Default to root if no specific paths found
    if (scanPaths.isEmpty()) {
        scanPaths << '.'
    }
    
    echo "Scan paths: ${scanPaths.join(', ')}"
    return scanPaths
}

pipeline {
    agent any

    parameters {
        string(name: 'SCAN_ID', defaultValue: '')
        choice(name: 'SCAN_MODE', choices: ['AUTOMATED', 'MANUAL'])
        text(name: 'PROJECT_DATA', defaultValue: '{}')
        text(name: 'SELECTED_STAGES', defaultValue: '[]')
        text(name: 'SCAN_TIMEOUT', defaultValue: '7200')  // Dynamic timeout in seconds
        string(name: 'CALLBACK_TOKEN', defaultValue: '', description: 'Callback token for backend auth')
        string(name: 'SCANNER_SRC_DIR', defaultValue: '', description: 'Path to scanner files when running as pipeline script (e.g. /home/user/repo/backend/nmap_system)')
        string(name: 'CRED_GITHUB', defaultValue: 'github-credentials', description: 'Jenkins credential ID for Git checkout')
        string(name: 'CRED_DOCKER', defaultValue: 'docker-credentials', description: 'Jenkins credential ID for Docker registry login')
        string(name: 'CRED_CALLBACK', defaultValue: 'callback-token', description: 'Jenkins credential ID for platform callback token')
        string(name: 'CRED_NVD_API', defaultValue: 'nvd-api-key', description: 'Jenkins credential ID for NVD API key')
    }

    environment {
        // Configurable URLs — override via Jenkins global env vars or job params
        BACKEND_URL = "${env.BACKEND_URL ?: 'http://localhost:8000'}"
        JENKINS_URL = "${env.JENKINS_BASE_URL ?: 'http://localhost:8080'}"
        CALLBACK_URL = "${BACKEND_URL}/api/v1/scans/${params.SCAN_ID}/callback"
        REPORT_DIR = "reports"
        // Tool paths — override via Jenkins tools or env vars
        TRIVY_PATH = "${env.TRIVY_PATH ?: 'trivy'}"
        JAVA_HOME_DIR = "${env.JAVA_HOME_DIR ?: ''}"
        ZAP_PORT = "${env.ZAP_PORT ?: '8090'}"

        // Registry config — set DOCKER_REGISTRY for private registries (e.g. ghcr.io, ecr)
        DOCKER_REGISTRY = "${env.DOCKER_REGISTRY ?: ''}"
    }

    options {
        // Dynamic timeout based on scan complexity (default 2 hours)
        timeout(time: params.SCAN_TIMEOUT ? params.SCAN_TIMEOUT.toInteger() : 7200, unit: 'SECONDS')
        disableConcurrentBuilds()
        skipStagesAfterUnstable()
        retry(1)
        // Keep build logs for debugging
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Init Context') {
            steps {
                script {
                    // Debug logging
                    echo "=== Init Context Started ==="
                    echo "SCAN_ID received: ${params.SCAN_ID}"
                    echo "SCAN_MODE received: ${params.SCAN_MODE}"
                    
                    // Validate SCAN_ID
                    if (!params.SCAN_ID?.trim()) {
                        error("SCAN_ID is mandatory. Backend handshake failed.")
                    }
                    
                    if (params.SCAN_ID =~ /\s/) {
                        error("SCAN_ID must not contain spaces. Use UUID format.")
                    }
                    
                    echo "SCAN_ID validation passed"
                    
                    // Unescape HTML entities in parameters
                    def projectData = params.PROJECT_DATA.replaceAll('&quot;', '"').replaceAll('&#39;', "'")
                    def selectedStages = params.SELECTED_STAGES.replaceAll('&quot;', '"').replaceAll('&#39;', "'")
                    
                    echo "Unescaped PROJECT_DATA: ${projectData}"
                    echo "Unescaped SELECTED_STAGES: ${selectedStages}"
                    
                    // Parse JSON using readJSON (sandbox-safe)
                    def projectMap = readJSON text: projectData
                    PROJECT = new HashMap(projectMap)

                    def selectedList = readJSON text: selectedStages
                    SELECTED = new ArrayList(selectedList)

                    IS_MANUAL = params.SCAN_MODE == "MANUAL"
                    sh "mkdir -p reports"

                    // Validate branch name (prevent injection)
                    def branchName = PROJECT.branch ?: 'main'
                    if (!(branchName ==~ /^[a-zA-Z0-9._\/-]+$/)) {
                        error("Invalid branch name: ${branchName}")
                    }

                    // Validate Git URL (optional whitelist — set SKIP_GIT_WHITELIST=true to allow any)
                    def gitUrl = PROJECT.git_url
                    if (gitUrl && !env.SKIP_GIT_WHITELIST) {
                        def allowedPrefixes = (env.GIT_ALLOWED_PREFIXES ?: 'https://github.com/,https://gitlab.com/,https://bitbucket.org/,https://gitlab.,https://gitea.,https://dev.azure.com/,https://codecommit.')
                            .split(',').collect { it.trim() }
                        def allowed = allowedPrefixes.any { prefix -> gitUrl.startsWith(prefix) }
                        if (!allowed) {
                            error("Git URL not in allowed prefixes: ${gitUrl}. Set SKIP_GIT_WHITELIST=true or configure GIT_ALLOWED_PREFIXES")
                        }
                    }

                    echo "Parsed PROJECT: ${PROJECT}"
                    echo "Parsed SELECTED: ${SELECTED}"
                    echo "IS_MANUAL: ${IS_MANUAL}"
                    echo "=== Init Context Completed ==="
                }
            }
        }

        stage('Git Checkout') {
            steps {
                script {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: PROJECT.branch ?: 'main']],
                        userRemoteConfigs: [[
                            url: PROJECT.git_url,
                            credentialsId: PROJECT.credentials_id ?: params.CRED_GITHUB
                        ]]
                    ])
                    recordStage('git_checkout', 'PASS', 'Git checkout successful')
                }
            }
        }

        stage('Sonar Scanner') {
            when { expression { shouldRun('sonar_scanner') } }
            steps {
                // Per-stage timeout: 15 minutes for Sonar analysis
                timeout(time: 15, unit: 'MINUTES') {
                    script {
                        // Get the SonarQube Scanner tool path
                        def scannerHome = tool 'sonar-scanner'

                        try {
                            // Use Jenkins SonarQube server configuration
                            def projectName = PROJECT.project_name ?: params.SCAN_ID
                            withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                                withSonarQubeEnv('sonar-server') {
                                    withEnv(["SONAR_SCANNER_OPTS=-XX:TieredStopAtLevel=3"]) {
                                        sh """
                                            mkdir -p reports
                                            ${scannerHome}/bin/sonar-scanner \
                                              -Dsonar.projectKey="${PROJECT.sonar_key ?: params.SCAN_ID}" \
                                              -Dsonar.projectName="${projectName}" \
                                              -Dsonar.sourceEncoding=UTF-8 \
                                              -Dsonar.typescript.tsconfigPath=tsconfig.json \
                                              -Dsonar.token=\$SONAR_TOKEN \
                                              -Dsonar.exclusions=node_modules/**,dist/**,build/**,.next/**,coverage/**,reports/**,vendor/**,*.min.js \
                                              2>&1 | tee reports/sonar-scanner-output.log
                                        """
                                    }
                                }
                            }

                            // Generate Sonar scan report for artifacts
                            def timestamp = new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC'))
                            writeFile file: 'reports/sonar-scanner-report.json',
                                text: groovy.json.JsonOutput.toJson([
                                    projectKey: PROJECT.sonar_key ?: params.SCAN_ID,
                                    projectName: projectName,
                                    status: 'completed',
                                    timestamp: timestamp
                                ])

                            recordStage('sonar_scanner', 'PASS', 'Sonar scan completed')
                        } catch (Exception e) {
                            // Read the captured scanner output for error details
                            def sonarLog = ""
                            try { sonarLog = readFile('reports/sonar-scanner-output.log') } catch (_) {}
                            def errorLines = sonarLog.split('\n').findAll {
                                it.contains('ERROR') || it.contains('SyntaxError') || it.contains('FAILURE') || it.contains('error TS')
                            }
                            def errorDetail = errorLines ? errorLines.take(8).join(' | ') : "${e.message}".take(300)
                            def trimmed = errorDetail.length() > 500 ? errorDetail.take(500) + '...' : errorDetail

                            // Generate failure report
                            def timestamp = new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC'))
                            writeFile file: 'reports/sonar-scanner-report.json',
                                text: groovy.json.JsonOutput.toJson([
                                    projectKey: PROJECT.sonar_key ?: params.SCAN_ID,
                                    status: 'failed',
                                    error: trimmed,
                                    timestamp: timestamp
                                ])
                            echo "⚠️  SonarQube failed: ${trimmed}"
                            echo "   Continuing pipeline with other security scans..."
                            recordStage('sonar_scanner', 'WARN', "SonarQube failed: ${trimmed}")
                        }
                    }
                }
            }
        }

        stage('Dependency Check') {
            when { expression { shouldRun('dependency_check') } }
            steps {
                script {
                    // Ensure report directory exists before running dependency check
                    sh "mkdir -p reports"

                    // Install npm dependencies so ODC can find Node.js vulnerabilities
                    def installDirs = sh(
                        script: "find . -name 'package.json' ! -path '*/node_modules/*' -exec dirname {} \\; | sort -u",
                        returnStdout: true
                    ).trim().split('\n').findAll { it }
                    def npmSucceeded = 0
                    def npmFailed = 0
                    installDirs.each { dir ->
                        def ok = sh(
                            script: "cd ${dir} && npm install --package-lock-only 2>&1 && echo 'OK' || echo 'FAIL'",
                            returnStdout: true
                        ).trim()
                        if (ok == 'OK') {
                            npmSucceeded++
                        } else {
                            npmFailed++
                            echo "WARNING: npm install --package-lock-only failed in ${dir}"
                        }
                    }

                    // Check for lock files ANYWHERE in workspace (not just root)
                    def lockFileCount = sh(
                        script: "find . -name 'package-lock.json' ! -path '*/node_modules/*' 2>/dev/null | wc -l",
                        returnStdout: true
                    ).trim().toInteger()
                    def yarnLockCount = sh(
                        script: "find . -name 'yarn.lock' ! -path '*/node_modules/*' 2>/dev/null | wc -l",
                        returnStdout: true
                    ).trim().toInteger()
                    def hasNpmLock = lockFileCount > 0
                    def hasYarnLock = yarnLockCount > 0

                    // Build OWASP Dependency-Check arguments
                    def scanArgs = [
                        "--project ${params.SCAN_ID}",
                        "--format JSON",
                        "--format HTML",
                        "--out reports",
                        "--enableExperimental",
                        '--exclude "**/node_modules/**"',
                        '--exclude "**/.venv/**"',
                        '--exclude "**/dist/**"',
                        '--exclude "**/build/**"',
                        '--exclude "**/reports/**"'
                    ]

                    // Scan lock files if they exist, else scan source files only
                    if (hasNpmLock) {
                        scanArgs << "--scan ./**/package-lock.json"
                        echo "Found ${lockFileCount} package-lock.json file(s) — scanning npm dependencies"
                    }
                    if (hasYarnLock) {
                        scanArgs << "--scan ./**/yarn.lock"
                        echo "Found ${yarnLockCount} yarn.lock file(s) — scanning yarn dependencies"
                    }
                    if (!hasNpmLock && !hasYarnLock) {
                        scanArgs << "--scan ."
                        scanArgs << '--exclude "**/node_modules*/**"'
                        def reason = npmFailed > 0 && npmSucceeded == 0
                            ? "npm install --package-lock-only failed in ${npmFailed}/${installDirs.size()} package.json dir(s)"
                            : installDirs.isEmpty()
                                ? "no package.json found in workspace"
                                : "npm install --package-lock-only succeeded but lock files not generated"
                        echo "WARNING: No lock files found (${reason}). Dependency Check will only scan non-Node.js dependencies (pip, gradle, etc.)"
                    }

                    // Add custom exclusions from project config if available
                    if (PROJECT.dependency_exclusions) {
                        scanArgs << "--exclude ${PROJECT.dependency_exclusions}"
                    }

                    echo "Running OWASP Dependency-Check (${scanArgs.size()} args, NVD key masked)"

                    def odcJvmCrashed = false
                    withCredentials([string(credentialsId: params.CRED_NVD_API, variable: 'NVD_API_KEY')]) {
                        def argsWithKey = scanArgs + ["--nvdApiKey ${NVD_API_KEY}"]
                        def javaEnv = ["JAVA_OPTS=-Xmx4g -Xms512m -XX:+UseParallelGC -XX:CompileCommand=exclude,org/h2/mvstore/cache/CacheLongLIRS\\\$Segment.put"]
                        if (env.JAVA_HOME_DIR) {
                            javaEnv << "JAVA_HOME=${env.JAVA_HOME_DIR}"
                        }
                        withEnv(javaEnv) {
                            catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                                dependencyCheck additionalArguments: argsWithKey.join(' '), odcInstallation: 'OWasp'
                            }
                            // If catchError caught a JVM crash, reports are still on disk
                            if (currentBuild.result == 'UNSTABLE' || currentBuild.result == 'FAILURE') {
                                odcJvmCrashed = true
                                echo "WARNING: ODC JVM crashed during database defrag — reports were written before crash"
                            }
                        }
                    }
                    def depSummary = "Dependency check completed"
                    if (lockFileCount > 0 || yarnLockCount > 0) {
                        def parts = []
                        if (lockFileCount > 0) { parts << "${lockFileCount} npm" }
                        if (yarnLockCount > 0) { parts << "${yarnLockCount} yarn" }
                        depSummary = "Dependency check completed (${parts.join(' + ')} lock file(s))"
                        if (odcJvmCrashed) {
                            depSummary += " — ODC JVM crashed after report generation"
                        }
                    } else {
                        def reason = installDirs.isEmpty()
                            ? "no package.json found"
                            : "npm install --package-lock-only failed"
                        depSummary = "Dependency check completed — 0 Node.js deps analyzed (${reason})"
                    }
                    recordStage('dependency_check', odcJvmCrashed ? 'WARN' : 'PASS', depSummary)

                    // Publish HTML report
                    publishHTML([
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'reports',
                        reportFiles: 'dependency-check-report.html',
                        reportName: 'OWASP Dependency Check'
                    ])
                }
            }
        }

        stage('Trivy FS Scan') {
            when { expression { shouldRun('trivy_fs_scan') } }
            steps {
                sh """
                    if [ ! -d node_modules ]; then
                        echo "WARNING: node_modules not found — Trivy FS will only analyze source files. Run 'npm install' for broader dependency coverage."
                    fi
                    ${TRIVY_PATH} fs --format json \
                      --skip-files "reports/**" \
                      -o reports/trivy-fs.json . > reports/trivy-fs-output.log 2>&1 || true
                """
                script {
                    def trivyOutput = ""
                    try { trivyOutput = readFile('reports/trivy-fs-output.log') } catch (_) {}
                    def warnLines = trivyOutput.split('\n').findAll {
                        it.contains('WARNING') || it.contains('WARN') || it.contains('error') || it.contains('Error') || it.contains('FATAL')
                    }
                    def detail = warnLines ? ' | Warnings: ' + warnLines.take(5).join(' ;; ') : ''
                    recordStage('trivy_fs_scan', 'PASS', 'Trivy FS scan completed' + detail)
                }
            }
        }

        stage('Docker Build') {
            when { expression { shouldRun('docker_build') } }
            steps {
                script {
                    // Find all Dockerfiles in the repository
                    def dockerfiles = []
                    def output = sh(
                        script: "find . -type f \\( -name 'Dockerfile*' -o -name '*.Dockerfile' \\) ! -name '*.md' | sort",
                        returnStdout: true
                    ).trim()

                    if (output) {
                        dockerfiles = output.split('\n').findAll { it.trim() }
                    }

                    if (dockerfiles.isEmpty()) {
                        echo "No Dockerfiles found - skipping Docker build"
                        recordStage('docker_build', 'SKIPPED', 'No Dockerfiles found')
                        return
                    }

                    echo "Found ${dockerfiles.size()} Dockerfiles: ${dockerfiles.join(', ')}"

                    // Build each Dockerfile found and store results
                    def buildResults = []
                    def failedBuilds = []
                    def failedDetails = []   // detailed error output per failed build
                    def allImageTags = []

                    dockerfiles.each { dockerfile ->
                        def imageName = dockerfile.replaceAll('^[./]+', '').replaceAll('[^a-zA-Z0-9]', '-').toLowerCase().take(100)
                        def imageTag = "${PROJECT.project_id ?: 'scan'}:${imageName}-${params.SCAN_ID}"
                        // Build from repo root — Dockerfiles use paths like backend/relative to root
                        def buildContext = '.'

                        echo "Building ${dockerfile}..."

                        // Capture output regardless of exit code (no try/catch)
                        def buildOutput = sh(returnStdout: true, script: """
                            set +e
                            docker build -t ${imageTag} -f ${dockerfile} ${buildContext} 2>&1
                            echo "___EXIT___\$?"
                        """)
                        def lines = buildOutput.split('\n')
                        def exitLine = lines.find { it.startsWith('___EXIT___') }
                        def exitCode = exitLine?.replace('___EXIT___', '')?.trim()
                        def cleanOutput = lines.findAll { !it.startsWith('___EXIT___') }.join('\n')

                        if (exitCode == '0') {
                            allImageTags << imageTag
                            buildResults << dockerfile
                            echo "SUCCESS: ${dockerfile} built successfully"
                        } else {
                            failedBuilds << dockerfile
                            // Extract relevant error lines from build output
                            def errorLines = cleanOutput.split('\n').findAll { it.contains('error TS') || it.contains('ERROR:') || it.contains('Error ') }
                            def detail = errorLines ? errorLines.take(8).join(' | ') : cleanOutput.take(250).replace('\n', ' ')
                            failedDetails << "${dockerfile}: ${detail}"
                            echo "FAILED: ${dockerfile}"
                        }
                    }

                    // Store all image tags for later stages
                    env.ALL_IMAGE_TAGS = allImageTags.join(',')
                    env.DOCKERFILE_COUNT = allImageTags.size().toString()

                    // Record overall stage status
                    def errorSummary = failedDetails ? ' | Errors: ' + failedDetails.join(' ;; ') : ''
                    if (failedBuilds.isEmpty()) {
                        def successList = buildResults.collect { it + " - SUCCESS" }
                        recordStage('docker_build', 'PASS', 'Built: ' + successList.join(', '))
                    } else if (buildResults.isEmpty()) {
                        def errorList = failedBuilds.collect { it + " - FAILED" }
                        recordStage('docker_build', 'FAIL', 'Failed: ' + errorList.join(', ') + errorSummary)
                    } else {
                        def successList = buildResults.collect { it + " - SUCCESS" }
                        def failedList = failedBuilds.collect { it + " - FAILED" }
                        recordStage('docker_build', 'WARN', 'Succeeded: ' + successList.join(', ') + ' | Failed: ' + failedList.join(', ') + errorSummary)
                    }

                    // Generate Docker build report
                    def reportJson = groovy.json.JsonOutput.toJson([
                        total: dockerfiles.size(),
                        successful: buildResults.size(),
                        failed: failedBuilds.size(),
                        images: allImageTags.collect { [tag: it, status: "SUCCESS"] },
                        failures: failedBuilds.collect { [dockerfile: it, status: "FAILED"] },
                        timestamp: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC'))
                    ])
                    writeFile file: "reports/docker-build-report.json", text: reportJson

                    // Continue pipeline even if some builds failed
                    // Only skip Trivy Image Scan if no images were built
                    if (allImageTags.isEmpty()) {
                        echo "No Docker images built successfully - skipping Docker Push and Trivy Image Scan"
                    }
                }
            }
        }

        stage('Docker Push') {
            when { expression { shouldRun('docker_push') } }
            steps {
                withCredentials([usernamePassword(credentialsId: params.CRED_DOCKER,
                                                  usernameVariable: 'DOCKER_USER',
                                                  passwordVariable: 'DOCKER_PASS')]) {
                    script {
                        def allImageTags = env.ALL_IMAGE_TAGS ? env.ALL_IMAGE_TAGS.split(',') as List : []

                        if (allImageTags.isEmpty()) {
                            echo "No images to push - skipping Docker push"
                            recordStage('docker_push', 'SKIPPED', 'No images to push')
                            return
                        }

                        def pushedImages = []
                        def failedPushes = []

                        // Determine registry prefix
                        def dockerRegistry = env.DOCKER_REGISTRY ?: ''
                        def registryPrefix = dockerRegistry ? "${dockerRegistry}/" : ""

                        // Push each image
                        allImageTags.each { imageTag ->
                            def imageName = imageTag.replaceAll('[^a-zA-Z0-9/]', '-').toLowerCase()
                            def pushTag = "${registryPrefix}${DOCKER_USER}/${imageName}".toString()

                            echo "Pushing ${imageTag} as ${pushTag}"

                            def pushSuccess = false
                            try {
                                sh "docker tag ${imageTag} ${pushTag}"
                                def loginArgs = dockerRegistry ? "-u \"$DOCKER_USER\" --password-stdin ${dockerRegistry}" : "-u \"$DOCKER_USER\" --password-stdin"
                                sh "echo \"$DOCKER_PASS\" | docker login ${loginArgs}"
                                sh "docker push ${pushTag} 2>&1"
                                pushedImages << pushTag
                                pushSuccess = true
                                echo "SUCCESS: ${pushTag} pushed"
                            } catch (Exception e) {
                                def pushError = e.message.replaceAll('denied:.*', 'denied: access forbidden — check Docker Hub credentials').take(200)
                                failedPushes << "${pushTag} - FAILED (${pushError})"
                                echo "FAILED: ${pushTag} — ${pushError}"
                            }
                        }

                        // Record overall stage status
                        if (failedPushes.isEmpty()) {
                            def successList = pushedImages.collect { it + " - SUCCESS" }
                            recordStage('docker_push', 'PASS', 'Pushed: ' + successList.join(', '))
                        } else if (pushedImages.isEmpty()) {
                            def errorList = failedPushes.collect { it + " - FAILED" }
                            recordStage('docker_push', 'FAIL', 'Failed: ' + errorList.join(', '))
                        } else {
                            def successList = pushedImages.collect { it + " - SUCCESS" }
                            def failedList = failedPushes.collect { it + " - FAILED" }
                            recordStage('docker_push', 'WARN', 'Succeeded: ' + successList.join(', ') + ' | Failed: ' + failedList.join(', '))
                        }

                        // Generate Docker push report
                        def pushReportJson = groovy.json.JsonOutput.toJson([
                            total: allImageTags.size(),
                            successful: pushedImages.size(),
                            failed: failedPushes.size(),
                            pushed: pushedImages.collect { [tag: it, status: "SUCCESS"] },
                            failures: failedPushes.collect { [tag: it, status: "FAILED"] },
                            timestamp: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC'))
                        ])
                        writeFile file: "reports/docker-push-report.json", text: pushReportJson

                        // Continue pipeline even if some pushes failed
                    }
                }
            }
        }

        stage('Trivy Image Scan') {
            when { expression { shouldRun('trivy_image_scan') } }
            steps {
                script {
                    def allImageTags = env.ALL_IMAGE_TAGS ? env.ALL_IMAGE_TAGS.split(',') as List : []
                    
                    if (allImageTags.isEmpty()) {
                        echo "No images to scan - skipping Trivy image scan"
                        recordStage('trivy_image_scan', 'SKIPPED', 'No images to scan')
                        return
                    }

                    def scannedImages = []
                    def scanErrors = []

                    // Scan each image
                    allImageTags.each { imageTag ->
                        def safeTag = imageTag.toString()
                        echo "Scanning image: ${safeTag}"

                        // Derive readable filename from image tag
                        def imageName = imageTag.replaceAll('[^a-zA-Z0-9]', '-').toLowerCase()
                        def outputFile = "reports/trivy-image-${imageName}.json"

                        def scanSuccess = false
                        try {
                            sh "${TRIVY_PATH} image --format json -o ${outputFile} ${safeTag} > reports/trivy-image-${imageName}.log 2>&1"
                            scannedImages << safeTag + " - SUCCESS"
                            scanSuccess = true
                            echo "SUCCESS: ${safeTag} scanned"
                        } catch (Exception e) {
                            def trivyLog = ""
                            try { trivyLog = readFile("reports/trivy-image-${imageName}.log") } catch (_) {}
                            def errorLines = trivyLog.split('\n').findAll {
                                it.contains('FATAL') || it.contains('ERROR') || it.contains('error') || it.contains('unable')
                            }
                            def detail = errorLines ? errorLines.take(3).join(' | ') : e.message.take(200)
                            scanErrors << "${safeTag} - FAILED (${detail})"
                            echo "FAILED: ${safeTag} - ${detail}"
                        }
                    }

                    // Record overall stage status
                    if (scanErrors.isEmpty()) {
                        recordStage('trivy_image_scan', 'PASS', 'Scanned: ' + scannedImages.join(', '))
                    } else if (scannedImages.isEmpty()) {
                        recordStage('trivy_image_scan', 'FAIL', 'Failed: ' + scanErrors.join(', '))
                    } else {
                        recordStage('trivy_image_scan', 'WARN', 'Succeeded: ' + scannedImages.join(', ') + ' | Failed: ' + scanErrors.join(', '))
                    }

                    // Merge individual image reports into single file for fetcher
                    sh """
                        ls reports/trivy-image-*.json >/dev/null 2>&1 && python3 -c "
import json, glob
r = []
for f in sorted(glob.glob('reports/trivy-image-*.json')):
    try:
        d = json.load(open(f))
        r.extend(d.get('Results', []))
    except Exception as e:
        print(f'Skip {f}: {e}')
with open('reports/trivy-image.json', 'w') as f:
    json.dump({'Results': r}, f)
print(f'Merged {len(r)} results')
" || echo 'No trivy-image-*.json files to merge'
"""
                }
            }
        }

        stage('Nmap System Scan') {
            when { expression { shouldRun('nmap_scan') } }
            steps {
                script {
                    if (!PROJECT.target_ip) {
                        if (IS_MANUAL) {
                            error("target_ip required for manual Nmap scan")
                        }
                        echo "SKIP: No target_ip provided"
                        return
                    }

                    sh "mkdir -p reports"

                    // Scanner files belong to the platform (not the scanned repo).
                    // Try these sources in order: SCANNER_SRC_DIR param -> download from backend API -> bundled
                    def scannerDir = 'nmap_scanner'
                    sh "mkdir -p ${scannerDir}"

                    def scannerFilesFound = false

                    // 1) SCANNER_SRC_DIR parameter (from backend trigger)
                    if (params.SCANNER_SRC_DIR?.trim()) {
                        def result = sh(script: "ls ${params.SCANNER_SRC_DIR}/scanner.py 2>/dev/null", returnStatus: true)
                        if (result == 0) {
                            sh "cp ${params.SCANNER_SRC_DIR}/scanner.py ${params.SCANNER_SRC_DIR}/parser.py ${scannerDir}/ 2>/dev/null || true"
                            scannerFilesFound = true
                            echo "Copied scanner files from SCANNER_SRC_DIR: ${params.SCANNER_SRC_DIR}"
                        }
                    }

                    // 2) Download from backend API (platform serves scanner files)
                    if (!scannerFilesFound) {
                        withCredentials([string(credentialsId: params.CRED_CALLBACK, variable: 'CALLBACK_TOKEN')]) {
                            def downloadResult = sh(script: """
                                curl -sS -f -o ${scannerDir}/scanner.py \
                                  -H "X-Callback-Token: \$CALLBACK_TOKEN" \
                                  "${BACKEND_URL}/api/v1/scanner/scanner.py" 2>/dev/null && \
                                curl -sS -f -o ${scannerDir}/parser.py \
                                  -H "X-Callback-Token: \$CALLBACK_TOKEN" \
                                  "${BACKEND_URL}/api/v1/scanner/parser.py" 2>/dev/null && \
                                echo "downloaded" || echo "failed"
                            """, returnStdout: true).trim()
                            if (downloadResult == 'downloaded') {
                                scannerFilesFound = true
                                echo "Downloaded scanner files from backend API"
                            }
                        }
                    }

                    // 3) Fallback: check workspace (for backwards compatibility)
                    if (!scannerFilesFound) {
                        if (fileExists('backend/nmap_system/scanner.py')) {
                            sh "cp backend/nmap_system/scanner.py backend/nmap_system/parser.py ${scannerDir}/ 2>/dev/null || true"
                            scannerFilesFound = true
                            echo "Copied scanner files from workspace: backend/nmap_system/"
                        } else if (fileExists('scanner.py')) {
                            sh "cp scanner.py parser.py ${scannerDir}/ 2>/dev/null || true"
                            scannerFilesFound = true
                            echo "Copied scanner files from workspace root"
                        }
                    }

                    if (!scannerFilesFound) {
                        echo "SKIP: scanner files not found (tried: SCANNER_SRC_DIR, backend API, workspace)"
                        recordStage('nmap_scan', 'SKIPPED', 'Scanner files not found')
                        return
                    }

                    def nmapOutput = sh(returnStdout: true, script: """
                        set +e
                        cd ${scannerDir}

                        echo '{"client":"Pipeline Auto Scan","month":"${new Date().format("MMMM yyyy")}","targets":[{"ip":"${PROJECT.target_ip}","name":"scan-target","environment":"Test"}]}' > targets.json

                        python3 scanner.py 2>&1

                        python3 parser.py 2>&1

                        echo "___EXIT___\$?"
                    """)
                    def nmapLines = nmapOutput.split('\n')
                    def nmapExitLine = nmapLines.find { it.startsWith('___EXIT___') }
                    def nmapExitCode = nmapExitLine?.replace('___EXIT___', '')?.trim()
                    def nmapCleanOutput = nmapLines.findAll { !it.startsWith('___EXIT___') }.join('\n')

                    sh """
                        cp ${scannerDir}/scans/*/findings.json reports/nmap_findings.json
                        # Copy raw per-scan txt files to reports
                        find ${scannerDir}/scans -name "*.txt" -type f -exec cp {} reports/ \\; 2>/dev/null || true
                        echo "Nmap system scan completed"
                    """

                    def nmapErrors = nmapExitCode != '0' ? nmapCleanOutput.split('\n').findAll {
                        it.contains('Traceback') || it.contains('Error') || it.contains('error') || it.contains('FAILED')
                    } : []
                    def nmapDetail = nmapErrors ? ' | Errors: ' + nmapErrors.take(5).join(' ;; ') : ''
                    recordStage('nmap_scan', nmapExitCode == '0' ? 'PASS' : 'WARN', 'Nmap system scan completed (11 scans + parser)' + nmapDetail)
                }
            }
        }

        stage('ZAP Scan') {
            when { expression { shouldRun('zap_scan') } }
            steps {
                script {
                    if (!PROJECT.target_url) {
                        if (IS_MANUAL) {
                            error("target_url required for manual ZAP scan")
                        }
                        echo "SKIP: No target_url provided"
                        recordStage('zap_scan', 'SKIPPED', 'No target URL provided')
                        return
                    }

                    // Check target connectivity before starting ZAP
                    echo "Checking target URL connectivity: ${PROJECT.target_url}"
                    def targetReachable = sh(
                        script: "curl -s -o /dev/null --max-time 30 '${PROJECT.target_url}' && echo 'reachable' || echo 'unreachable'",
                        returnStdout: true
                    ).trim()
                    if (targetReachable != 'reachable') {
                        echo "WARNING: Target URL ${PROJECT.target_url} is unreachable from Jenkins agent"
                        echo "ZAP requires a running target to scan — skipping ZAP scan"
                        recordStage('zap_scan', 'WARN', "Target unreachable: ${PROJECT.target_url}")
                        return
                    }

                    def zapPort = env.ZAP_PORT ?: '8090'
                    def zapFailed = false
                    def zapErrorDetail = ""
                    withEnv(["TARGET_URL=${PROJECT.target_url}", "ZAP_PORT=${zapPort}"]) {
                        try {
                            sh '''
                                set +e

                                mkdir -p reports

                                ZAP_PORT="${ZAP_PORT:-8090}"
                                echo "Starting ZAP daemon on port $ZAP_PORT..."

                                nohup zap.sh -daemon \
                                    -host 0.0.0.0 \
                                    -port "$ZAP_PORT" \
                                    -config api.disablekey=true \
                                    -config 'api.addrs.addr.name=.*' \
                                    -config api.addrs.addr.regex=true > reports/zap.log 2>&1 &

                                ZAP_PID=$!

                                echo "ZAP PID: $ZAP_PID"
                                echo "ZAP daemon log: reports/zap.log"

                                # Pre-wait: give Java and ZAP time to fully initialise before checking
                                echo "Pre-waiting 45s for ZAP Java process to initialise..."
                                sleep 45

                                # Check that ZAP process is still alive
                                if ! kill -0 "$ZAP_PID" 2>/dev/null; then
                                    echo "ZAP process died during initialisation"
                                    echo "--- ZAP log (last 80 lines) ---"
                                    tail -n 80 reports/zap.log 2>/dev/null || echo "(no zap.log)"
                                    exit 1
                                fi

                                echo "Waiting for ZAP API to become ready (up to ~5 min)..."
                                echo "Using ZAP version endpoint for health checks..."
                                ZAP_API_BASE="http://127.0.0.1:$ZAP_PORT"
                                ZAP_READY=0

                                for i in {1..60}; do
                                    # Check process is alive
                                    if ! kill -0 "$ZAP_PID" 2>/dev/null; then
                                        echo "ZAP process died during wait loop"
                                        echo "--- ZAP log (last 80 lines) ---"
                                        tail -n 80 reports/zap.log 2>/dev/null || echo "(no zap.log)"
                                        exit 1
                                    fi

                                    # Try version endpoint first (more reliable), fallback to root
                                    READY=$(curl -s -o /dev/null -w "%{http_code}" \
                                        "${ZAP_API_BASE}/JSON/core/view/version/" 2>/dev/null)

                                    if [ "$READY" = "200" ]; then
                                        echo "ZAP is ready (via version endpoint, HTTP 200)"
                                        ZAP_READY=1
                                        break
                                    fi

                                    # Fallback: try root endpoint
                                    READY=$(curl -s -o /dev/null -w "%{http_code}" \
                                        "${ZAP_API_BASE}/" 2>/dev/null)

                                    if [ "$READY" != "000" ]; then
                                        echo "ZAP is ready (via root endpoint, HTTP $READY)"
                                        ZAP_READY=1
                                        break
                                    fi

                                    echo "Check $i: $READY — retrying in 10s..."
                                    sleep 10
                                done

                                # Final verification
                                if [ "$ZAP_READY" != "1" ]; then
                                    echo "ZAP failed to become ready after all retries"
                                    echo "--- ZAP log (last 80 lines) ---"
                                    tail -n 80 reports/zap.log 2>/dev/null || echo "(no zap.log)"
                                    echo "--- Checking if port $ZAP_PORT is in use ---"
                                    ss -tlnp | grep "$ZAP_PORT" 2>/dev/null || echo "(no listener on $ZAP_PORT)"
                                    exit 1
                                fi

                                echo "Starting spider scan..."
                                ZAP_API_BASE="http://127.0.0.1:$ZAP_PORT"
                            
                                SPIDER_ID=$(curl -s \
                                    "${ZAP_API_BASE}/JSON/spider/action/scan/?url=$TARGET_URL" \
                                    | jq -r '.scan // empty')

                                if [ -z "$SPIDER_ID" ] || [ "$SPIDER_ID" = "null" ]; then
                                    echo "Failed to start spider scan"
                                    echo "--- ZAP log (last 30 lines) ---"
                                    tail -n 30 reports/zap.log 2>/dev/null
                                    exit 1
                                fi

                                echo "Spider ID: $SPIDER_ID"

                                # Wait for spider completion (with timeout)
                                SPIDER_START=$(date +%s)
                                SPIDER_TIMEOUT=600
                                while true; do
                                    SPIDER_ELAPSED=$(($(date +%s) - SPIDER_START))
                                    if [ $SPIDER_ELAPSED -gt $SPIDER_TIMEOUT ]; then
                                        echo "Spider timeout exceeded ($SPIDER_TIMEOUT s)"
                                        exit 1
                                    fi

                                    # Check ZAP is alive
                                    if ! kill -0 "$ZAP_PID" 2>/dev/null; then
                                        echo "ZAP process died during spider scan"
                                        echo "--- ZAP log (last 50 lines) ---"
                                        tail -n 50 reports/zap.log 2>/dev/null
                                        exit 1
                                    fi

                                    STATUS=$(curl -s \
                                        "${ZAP_API_BASE}/JSON/spider/view/status/?scanId=$SPIDER_ID" \
                                        | jq -r '.status // "0"')

                                    echo "Spider progress: ${STATUS}%"

                                    if [ "$STATUS" = "100" ]; then
                                        break
                                    fi

                                    sleep 5
                                done

                                echo "Spider completed"
                                echo "Waiting 15s for ZAP to process spider results..."
                                sleep 15

                                echo "Starting active scan..."

                                ASCAN_ID=$(curl -s \
                                    "${ZAP_API_BASE}/JSON/ascan/action/scan/?url=$TARGET_URL&recurse=true" \
                                    | jq -r '.scan // empty')

                                if [ -z "$ASCAN_ID" ] || [ "$ASCAN_ID" = "null" ]; then
                                    echo "Failed to start active scan"
                                    echo "--- ZAP log (last 30 lines) ---"
                                    tail -n 30 reports/zap.log 2>/dev/null
                                    exit 1
                                fi

                                echo "Active Scan ID: $ASCAN_ID"

                                # Wait for active scan completion (with timeout)
                                ASCAN_START=$(date +%s)
                                ASCAN_TIMEOUT=1800
                                while true; do
                                    ASCAN_ELAPSED=$(($(date +%s) - ASCAN_START))
                                    if [ $ASCAN_ELAPSED -gt $ASCAN_TIMEOUT ]; then
                                        echo "Active scan timeout exceeded ($ASCAN_TIMEOUT s)"
                                        exit 1
                                    fi

                                    # Check ZAP is alive
                                    if ! kill -0 "$ZAP_PID" 2>/dev/null; then
                                        echo "ZAP process died during active scan"
                                        echo "--- ZAP log (last 50 lines) ---"
                                        tail -n 50 reports/zap.log 2>/dev/null
                                        exit 1
                                    fi

                                    STATUS=$(curl -s \
                                        "${ZAP_API_BASE}/JSON/ascan/view/status/?scanId=$ASCAN_ID" \
                                        | jq -r '.status // "0"')

                                    echo "Active scan progress: ${STATUS}%"

                                    if [ "$STATUS" = "100" ]; then
                                        break
                                    fi

                                    sleep 10
                                done

                                echo "Active scan completed"

                                echo "Generating reports..."

                                curl -s \
                                    "${ZAP_API_BASE}/OTHER/core/other/htmlreport/" \
                                    -o reports/zap.html

                                curl -s \
                                    "${ZAP_API_BASE}/OTHER/core/other/jsonreport/" \
                                    -o reports/zap.json

                                if [ ! -f reports/zap.json ] || [ ! -s reports/zap.json ]; then
                                    echo "ZAP JSON report missing or empty"
                                    echo "--- ZAP log (last 30 lines) ---"
                                    tail -n 30 reports/zap.log 2>/dev/null
                                    exit 1
                                fi

                                echo "ZAP reports generated:"
                                ls -lh reports/zap.* 2>/dev/null

                                echo "Stopping ZAP..."
                                kill $ZAP_PID 2>/dev/null || true
                                sleep 3
                                kill -0 "$ZAP_PID" 2>/dev/null && kill -9 $ZAP_PID 2>/dev/null || true
                                echo "ZAP stopped"
                            '''
                            recordStage('zap_scan', 'PASS', 'ZAP scan completed successfully')
                        } catch (Exception e) {
                            def zapLog = ""
                            try { zapLog = readFile('reports/zap.log') } catch (_) {}
                            def errorLines = zapLog.split('\n').findAll {
                                it.contains('ERROR') || it.contains('Exception') || it.contains('failed') || it.contains('died')
                            }
                            zapErrorDetail = errorLines ? errorLines.take(5).join(' | ') : e.message.take(300)
                            def trimmed = zapErrorDetail.length() > 400 ? zapErrorDetail.take(400) + '...' : zapErrorDetail
                            echo "ZAP scan failed: ${trimmed}"
                            recordStage('zap_scan', 'FAIL', "ZAP scan failed: ${trimmed}")
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                archiveArtifacts artifacts: "reports/**", allowEmptyArchive: true

                def errorMessage = null
                def errorType = null
                def jenkinsConsoleUrl = null

                if (currentBuild.currentResult == 'FAILURE' || currentBuild.currentResult == 'ABORTED') {
                    def failedStage = STAGES_RESULTS ? STAGES_RESULTS.find { it.status == 'FAIL' } : null

                    if (currentBuild.buildCauses?.any { it.shortDescription?.contains('Timeout') }) {
                        errorType = 'TIMEOUT'
                        errorMessage = "Scan timed out after ${params.SCAN_TIMEOUT ? params.SCAN_TIMEOUT.toInteger() / 60 : 120} minutes"
                    } else if (failedStage) {
                        errorType = 'PIPELINE_ERROR'
                        errorMessage = "Pipeline failed at stage: ${failedStage.stage}. Check Jenkins console for details."
                    } else {
                        errorType = 'PIPELINE_ERROR'
                        errorMessage = "Pipeline failed. Check Jenkins console logs for details."
                    }

                    jenkinsConsoleUrl = "${env.JENKINS_URL}/job/${env.JOB_NAME}/${env.BUILD_NUMBER}/console"
                }

                def payload = [
                    status: currentBuild.currentResult,
                    build_number: currentBuild.number,
                    scan_id: params.SCAN_ID,
                    scan_mode: params.SCAN_MODE,
                    stages: STAGES_RESULTS ?: [],
                    finished_at: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC')),
                    ERROR_MESSAGE: errorMessage ?: "Pipeline completed with status: ${currentBuild.currentResult}",
                    ERROR_TYPE: errorType ?: 'SUCCESS',
                    JENKINS_CONSOLE_URL: jenkinsConsoleUrl
                ]

                sh script: """cat > callback.json << 'EOF'
${groovy.json.JsonOutput.toJson(payload)}
EOF
""", label: 'Write callback payload'

                withCredentials([string(credentialsId: params.CRED_CALLBACK, variable: 'CALLBACK_TOKEN')]) {
                    sh """
                        curl -sS -X POST \
                          -H "Content-Type: application/json" \
                          -H "X-Callback-Token: \$CALLBACK_TOKEN" \
                          --data @callback.json \
                          "${CALLBACK_URL}" \
                        || echo "Callback failed"
                    """
                }
            }
        }

        success {
            echo "Pipeline completed successfully for SCAN_ID: ${params.SCAN_ID}"
        }

        failure {
            echo "Pipeline failed for SCAN_ID: ${params.SCAN_ID}"
        }

        cleanup {
            cleanWs()
        }
    }
}

def shouldRun(stageName) {
    if (IS_MANUAL == false) {
        return true
    }
    return SELECTED.contains(stageName)
}

def recordStage(stageName, status, summary) {
    if (!binding.hasVariable('STAGES_RESULTS')) {
        STAGES_RESULTS = []
    }
    STAGES_RESULTS.add([
        stage: stageName.toString(),
        status: status.toString(),
        summary: summary.toString(),
        timestamp: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC'))
    ])
    echo "Recorded stage: ${stageName} - ${status}"
    
    // Send intermediate callback to update frontend
    sendIntermediateCallback(stageName)
}

def sendIntermediateCallback(finishedStage) {
    def currentStages = STAGES_RESULTS ?: []
    
    def payload = [
        status: 'RUNNING',
        build_number: currentBuild.number,
        scan_id: params.SCAN_ID,
        scan_mode: params.SCAN_MODE,
        stages: currentStages,
        finished_at: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC')),
        ERROR_MESSAGE: null,
        ERROR_TYPE: null,
        JENKINS_CONSOLE_URL: null
    ]
    
    sh script: """cat > callback.json << 'EOF'
${groovy.json.JsonOutput.toJson(payload)}
EOF
""", label: 'Write intermediate callback payload'
    
                withCredentials([string(credentialsId: params.CRED_CALLBACK, variable: 'CALLBACK_TOKEN')]) {
        sh """
            curl -sS -X POST \
              -H "Content-Type: application/json" \
              -H "X-Callback-Token: \$CALLBACK_TOKEN" \
              --data @callback.json \
              "${CALLBACK_URL}" \
             || echo "Intermediate callback failed"
        """
    }

}
